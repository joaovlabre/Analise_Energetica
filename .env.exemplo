# Modelo do .env (copie para .env, que fica fora do git, e troque a senha).
# Usado pelo docker-compose.yml e pela URL do banco no dispositivos.yaml:
#   banco:
#     url: postgresql+psycopg://${SGE_DB_USUARIO}:${SGE_DB_SENHA}@127.0.0.1:${SGE_DB_PORTA}/${SGE_DB_NOME}
SGE_DB_NOME=sge
SGE_DB_USUARIO=sge
SGE_DB_SENHA=troque-esta-senha
SGE_DB_PORTA=5432
